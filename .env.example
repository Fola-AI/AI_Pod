# --- Database (Neon / Vercel Postgres) ---
DATABASE_URL=

# --- Direct provider API keys ---
# Anthropic, OpenAI, Google hit their own endpoints (they carry native search).
# Groq is a deliberate direct exception, kept for its latency (see README).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# --- OpenRouter (one key for every non-direct vendor) ---
# xAI, DeepSeek, Meta, Mistral, Alibaba and anything new route through OpenRouter.
# Set a provider allowlist in your OpenRouter account (see README).
OPENROUTER_API_KEY=

# Production URL, sent as OpenRouter's HTTP-Referer for dashboard attribution.
# Falls back to http://localhost:3000 when unset.
APP_URL=

# --- Access gate ---
# Single shared password. Leave blank to disable the gate in local dev.
APP_ACCESS_PASSWORD=
