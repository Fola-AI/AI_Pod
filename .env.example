# --- Database (Neon / Vercel Postgres) ---
DATABASE_URL=

# --- Provider API keys (one per provider) ---
# Phase 1 adapters: Anthropic, OpenAI, Google. The rest arrive in Phase 2 —
# their keys are read but no adapter exists yet, so those models show as
# unavailable rather than crashing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
META_API_KEY=
MISTRAL_API_KEY=
ALIBABA_API_KEY=
GROQ_API_KEY=

# --- Access gate ---
# Single shared password. Leave blank to disable the gate in local dev.
APP_ACCESS_PASSWORD=
